{
  "name": "plastile",
  "private": true,
  "version": "0.1.0",
  "description": "Fast, predictable tiling policy for KDE Plasma that preserves KWin",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Yejashi/plastile",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yejashi/plastile.git"
  },
  "bugs": {
    "url": "https://github.com/Yejashi/plastile/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.runtime.json",
    "test": "node --test --test-reporter=spec tests/core/*.test.ts",
    "build": "node tools/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "check:docs": "python3 tools/check_docs.py",
    "integration": "python3 tests/integration/run.py",
    "integration:list": "python3 tests/integration/run.py --list",
    "release:check": "python3 tools/release.py --check --out dist"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
