        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="kcfg_bspAxis">
        <item><property name="text"><string>Alternate side by side and stacked</string></property></item>
        <item><property name="text"><string>Along the longer side of the tile</string></property></item>
        <item><property name="text"><string>Always side by side</string></property></item>
        <item><property name="text"><string>Always stacked</string></property></item>
       </widget>
      </item>
     </layout>
    </widget>
