        <property name="buddy">
         <cstring>kcfg_masterCount</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="kcfg_masterCount">
        <property name="maximum">
         <number>8</number>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="masterInsertLabel">
        <property name="text">
         <string>New windows go:</string>
        </property>
        <property name="buddy">
         <cstring>kcfg_masterInsert</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QComboBox" name="kcfg_masterInsert">
        <item><property name="text"><string>After the focused window</string></property></item>
        <item><property name="text"><string>At the end of the stack</string></property></item>
        <item><property name="text"><string>Into the master area</string></property></item>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="bspGroup">
     <property name="title">
      <string>Binary split (BSP)</string>
