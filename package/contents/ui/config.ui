<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PlastileConfigForm</class>
 <widget class="QWidget" name="PlastileConfigForm">
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="layoutGroup">
     <property name="title">
      <string>Layout</string>
     </property>
     <layout class="QFormLayout" name="layoutForm">
      <item row="0" column="0">
       <widget class="QLabel" name="layoutLabel">
        <property name="text">
         <string>Default layout:</string>
        </property>
        <property name="buddy">
         <cstring>kcfg_layout</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="kcfg_layout">
        <property name="toolTip">
         <string>Layout for every screen and desktop. Change it per screen with the layout shortcuts.</string>
        </property>
        <item><property name="text"><string>Master and stack</string></property></item>
        <item><property name="text"><string>Binary split (BSP)</string></property></item>
        <item><property name="text"><string>Monocle (one window at a time)</string></property></item>
        <item><property name="text"><string>Floating (no tiling)</string></property></item>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="gapInnerLabel">
        <property name="text">
         <string>Gap between windows:</string>
        </property>
        <property name="buddy">
         <cstring>kcfg_gapInner</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="kcfg_gapInner">
        <property name="suffix">
         <string> px</string>
        </property>
        <property name="maximum">
         <number>200</number>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="gapOuterLabel">
        <property name="text">
         <string>Gap at screen edges:</string>
        </property>
        <property name="buddy">
         <cstring>kcfg_gapOuter</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QSpinBox" name="kcfg_gapOuter">
        <property name="suffix">
         <string> px</string>
        </property>
        <property name="maximum">
         <number>200</number>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QCheckBox" name="kcfg_singleWindowGaps">
        <property name="text">
         <string>Keep screen-edge gaps around a single window</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="ratioStepLabel">
        <property name="text">
         <string>Grow/shrink step:</string>
        </property>
        <property name="buddy">
         <cstring>kcfg_ratioStep</cstring>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QDoubleSpinBox" name="kcfg_ratioStep">
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="minimum">
         <double>0.010000000000000</double>
        </property>
        <property name="maximum">
         <double>0.500000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.010000000000000</double>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="maximizedOnOpenLabel">
        <property name="text">
         <string>Windows that open maximized:</string>
        </property>
        <property name="buddy">
         <cstring>kcfg_maximizedOnOpen</cstring>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QComboBox" name="kcfg_maximizedOnOpen">
        <property name="toolTip">
         <string>For a window the application or KWin opens maximized. A window you maximize yourself always stays maximized.</string>
        </property>
        <item><property name="text"><string>Un-maximize and tile them</string></property></item>
        <item><property name="text"><string>Leave them maximized</string></property></item>
       </widget>
      </item>
      <item row="6" column="1">
       <widget class="QCheckBox" name="kcfg_osd">
        <property name="toolTip">
         <string>Plasma's on-screen display, as for volume or brightness. The log has the same news either way.</string>
        </property>
        <property name="text">
         <string>Show an on-screen message when a shortcut changes the layout or pauses tiling</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="masterGroup">
     <property name="title">
      <string>Master and stack</string>
