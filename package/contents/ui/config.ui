        <property name="minimum">
         <number>64</number>
        </property>
        <property name="maximum">
         <number>65536</number>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QLabel" name="configJsonLabel">
        <property name="text">
         <string>Per-screen overrides and window rules (JSON, see the documentation). Invalid input is rejected and the previous settings stay active.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QPlainTextEdit" name="kcfg_configJson">
        <property name="kcfg_property" stdset="0">
         <cstring>plainText</cstring>
        </property>
        <property name="kcfg_propertyNotify" stdset="0">
         <cstring>textChanged</cstring>
        </property>
        <property name="placeholderText">
